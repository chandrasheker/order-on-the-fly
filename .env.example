# =============================================================================
# TableTap — Environment variables
# Copy to .env and customize. See SETUP_GUIDE.md for full documentation.
# =============================================================================

# --- Database ---
# Local dev (default): SQLite file in project root
DATABASE_URL="file:./dev.db"
# Production / Docker: PostgreSQL
# DATABASE_URL="postgresql://tabletap:YOUR_PASSWORD@localhost:5432/tabletap"
# PRISMA_SCHEMA="prisma/schema.postgres.prisma"
# PRISMA_MIGRATIONS="prisma/migrations-postgres"

# --- Auth & security (REQUIRED in production — use long random strings) ---
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
TABLE_ACCESS_SECRET="change-this-table-access-secret-in-production"

# --- Public URL (REQUIRED for QR codes, webhooks, aggregator callbacks) ---
# Use your LAN IP for phone testing on same Wi-Fi: http://192.168.1.20:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Restaurant config file (optional) ---
# Defaults: restaurant.config.json → restaurant.config.example.json
# RESTAURANT_CONFIG="restaurant.config.json"

# --- Aggregator credentials encryption (production) ---
# 32+ byte hex or passphrase; falls back to JWT_SECRET in dev
# TABLETAP_CREDENTIALS_KEY="your-32-byte-hex-credentials-key"

# --- Webhook fallback secret (optional global override) ---
# Per-restaurant secrets are auto-generated in Admin → Integrations
# TABLETAP_WEBHOOK_SECRET="optional-global-webhook-secret"

# --- Zomato partner API (optional — defaults work for sandbox docs) ---
# ZOMATO_API_BASE="https://api.zomato.com"
# ZOMATO_MENU_SYNC_PATH="/online-ordering/v1/menu/sync"
# ZOMATO_ITEM_STOCK_PATH="/online-ordering/v1/menu/item/stock"
# ZOMATO_ORDER_READY_PATH="/online-ordering/v1/order/ready"
# ZOMATO_ORDER_PICKEDUP_PATH="/online-ordering/v1/order/pickedup"
# ZOMATO_ORDER_DELIVERED_PATH="/online-ordering/v1/order/delivered"

# --- Swiggy partner API (optional) ---
# SWIGGY_API_BASE="https://partner-api.swiggy.com"
# SWIGGY_MENU_SYNC_PATH="/api/v1/menu/sync"
# SWIGGY_ITEM_STOCK_PATH="/api/v1/menu/item/stock"
# SWIGGY_ORDER_READY_PATH="/api/v1/order/ready"
# SWIGGY_ORDER_PICKEDUP_PATH="/api/v1/order/pickedup"
# SWIGGY_ORDER_DELIVERED_PATH="/api/v1/order/delivered"

# --- Docker Compose only (see docker-compose.yml) ---
# POSTGRES_DB="tabletap"
# POSTGRES_USER="tabletap"
# POSTGRES_PASSWORD="tabletap_password"
# SEED_IF_EMPTY="true"

# --- Debug ---
# DEBUG="1"

# --- Tier 1: Push & SMS staff alerts (optional) ---
# Generate keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID_SUBJECT="mailto:admin@yourrestaurant.com"
# SMS_WEBHOOK_URL="https://your-sms-provider.com/send"
# STAFF_ALERT_PHONE="+919876543210"

# --- Reservations SMS (optional) ---
# POST { to, message, restaurantSlug } when notifying waitlist guests
# SMS_WEBHOOK_URL="https://your-sms-provider.com/send"
