{
  "name": "tabletap-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/init-db.js && next dev",
    "dev:clean": "node scripts/start-server.js",
    "start:clean": "node scripts/start-server.js --pull",
    "start:clean:keep-db": "node scripts/start-server.js --pull --no-clean",
    "build": "next build",
    "db:generate": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/init-db.js",
    "db:setup:single": "RESTAURANT_CONFIG=examples/tenant-single.config.json node scripts/init-db.js",
    "db:setup:dual": "RESTAURANT_CONFIG=examples/tenant-dual.config.json node scripts/init-db.js",
    "db:setup:triple": "RESTAURANT_CONFIG=examples/tenant-triple.config.json node scripts/init-db.js",
    "db:setup:quad": "RESTAURANT_CONFIG=examples/tenant-quad.config.json node scripts/init-db.js",
    "db:reset:single": "rm -f dev.db dev.db-journal dev.db-wal dev.db-shm && RESTAURANT_CONFIG=examples/tenant-single.config.json node scripts/init-db.js",
    "db:reset:dual": "rm -f dev.db dev.db-journal dev.db-wal dev.db-shm && RESTAURANT_CONFIG=examples/tenant-dual.config.json node scripts/init-db.js",
    "db:reset:triple": "rm -f dev.db dev.db-journal dev.db-wal dev.db-shm && RESTAURANT_CONFIG=examples/tenant-triple.config.json node scripts/init-db.js",
    "db:reset:quad": "rm -f dev.db dev.db-journal dev.db-wal dev.db-shm && RESTAURANT_CONFIG=examples/tenant-quad.config.json node scripts/init-db.js",
    "examples:configs": "node scripts/generate-example-configs.mjs",
    "db:reset": "rm -f dev.db dev.db-journal dev.db-wal dev.db-shm && node scripts/init-db.js",
    "db:reseed": "npx tsx prisma/seed.ts",
    "setup": "node scripts/setup-restaurant.mjs",
    "config:validate": "node -e \"require('./scripts/restaurant-config').loadRestaurantConfig() && console.log('Restaurant config is valid')\"",
    "config:validate:app": "tsx -e \"import { validateAppConfig } from './src/config/app-config'; validateAppConfig(); console.log('App config valid')\"",
    "qa:validate": "node scripts/qa-validate.mjs",
    "presentation": "node scripts/build-owner-presentation.mjs",
    "crash-dump": "node scripts/crash-dump.js --reason manual",
    "printer:agent": "node services/printer-agent/index.mjs",
    "worker": "node scripts/worker.mjs",
    "jobs:process": "curl -s -X POST http://localhost:3000/api/jobs/process",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
