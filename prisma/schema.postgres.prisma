generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  COOK
  SERVER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  UNAVAILABLE
}

enum TableSwitchRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

model Restaurant {
  id                    String         @id @default(cuid())
  name                  String
  slug                  String         @unique
  logoUrl               String?
  backgroundImageUrl    String?
  rewardThresholdTea    Float          @default(250)
  rewardThresholdBeverage Float        @default(500)
  rewardTeaLabel        String         @default("Free Masala Chai (next visit)")
  rewardBeverageLabel   String         @default("Free Beverage (next visit)")
  defaultMaxSessions  Int            @default(2)
  ownerSlots            Int            @default(1)
  managerSlots          Int            @default(2)
  cookSlots             Int            @default(3)
  serverSlots           Int            @default(4)
  staffConfigured       Boolean        @default(false)
  paymentQrUrl          String?
  receiptAddress        String?
  receiptPhone          String?
  receiptGstin          String?
  receiptGstEnabled     Boolean        @default(false)
  receiptGstRate        Float          @default(5)
  receiptFooter         String?
  createdAt             DateTime       @default(now())
  users                 User[]
  tables                Table[]
  tableSwitchRequests   TableSwitchRequest[]
  categories            MenuCategory[]
  orders                Order[]
  alerts                Alert[]
  feedbacks             Feedback[]
  rewards               Reward[]
  kitchenStations       KitchenStation[]
  payments              Payment[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role
  slotKey      String?
  plainPassword String?
  restaurantId String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedTables Table[]    @relation("TableServer")
  createdAt      DateTime   @default(now())

  @@unique([restaurantId, slotKey])
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Platform Admin")
  createdAt    DateTime @default(now())
}

model Table {
  id           String         @id @default(cuid())
  number       Int
  qrToken      String         @unique @default(cuid())
  isActive     Boolean        @default(true)
  orderingEnabled Boolean     @default(false)
  orderingOpenedAt DateTime?
  maxSessions  Int            @default(2)
  positionX    Float?
  positionY    Float?
  width        Float?         @default(96)
  height       Float?         @default(96)
  section      String?
  assignedServerId String?
  assignedServer   User?      @relation("TableServer", fields: [assignedServerId], references: [id], onDelete: SetNull)
  seatedAt     DateTime?
  guestCount   Int?
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  sessions     TableSession[]
  payments     Payment[]
  sourceSwitchRequests TableSwitchRequest[] @relation("SourceTableSwitchRequests")
  targetSwitchRequests TableSwitchRequest[] @relation("TargetTableSwitchRequests")

  @@unique([restaurantId, number])
}

model TableSession {
  id         String   @id @default(cuid())
  sessionKey String
  tableId    String
  table      Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([tableId, sessionKey])
  @@index([tableId, lastSeenAt])
}

model TableSwitchRequest {
  id                String                   @id @default(cuid())
  status            TableSwitchRequestStatus @default(PENDING)
  customerName      String?
  sessionKey        String
  note              String?
  sourceTableNumber Int
  targetTableNumber Int
  sourceTableId     String
  sourceTable       Table                    @relation("SourceTableSwitchRequests", fields: [sourceTableId], references: [id], onDelete: Cascade)
  targetTableId     String
  targetTable       Table                    @relation("TargetTableSwitchRequests", fields: [targetTableId], references: [id], onDelete: Cascade)
  restaurantId      String
  restaurant        Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  approvedByUserId  String?
  approvedByName    String?
  requestedAt       DateTime                 @default(now())
  respondedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([restaurantId, status])
  @@index([sourceTableId, status])
  @@index([targetTableId])
}

model MenuCategory {
  id           String     @id @default(cuid())
  name         String
  slug         String
  icon         String?
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@unique([restaurantId, slug])
}

model MenuItem {
  id              String       @id @default(cuid())
  name            String
  description     String?
  price           Float
  prepTimeMinutes Int          @default(10)
  imageUrl        String?
  isAvailable     Boolean      @default(true)
  isVeg           Boolean      @default(true)
  isSpicy         Boolean      @default(false)
  sortOrder       Int          @default(0)
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    Int
  customerName   String?
  status         OrderStatus @default(PENDING)
  tableId        String
  table          Table       @relation(fields: [tableId], references: [id])
  restaurantId   String
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  alarmTriggered Boolean     @default(false)
  rewardSpun     Boolean     @default(false)
  paidAt         DateTime?
  paymentRequestedAt DateTime?
  oosNoticeDismissedAt DateTime?
  placedByUserId     String?
  placedByName       String?
  paidByUserId       String?
  paidByName         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  date           String
  payments       Payment[]

  @@index([restaurantId, date])
  @@index([tableId])
}

model KitchenStation {
  id            String     @id @default(cuid())
  name          String
  slug          String
  color         String     @default("#3b82f6")
  categorySlugs String
  sortOrder     Int        @default(0)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, slug])
}

model Payment {
  id                String              @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId           String
  table             Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Float
  method            PaymentMethod       @default(UPI)
  note              String?
  collectedByUserId String?
  collectedByName   String?
  createdAt         DateTime            @default(now())
  allocations       PaymentAllocation[]

  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@index([tableId])
}

model PaymentAllocation {
  id          String    @id @default(cuid())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  amount      Float

  @@index([orderItemId])
}

model OrderItem {
  id              String          @id @default(cuid())
  quantity        Int             @default(1)
  status          OrderItemStatus @default(PENDING)
  prepTimeMinutes Int
  expectedReadyAt DateTime
  servedAt        DateTime?
  isOverdue       Boolean         @default(false)
  missedTimeline  Boolean         @default(false)
  minutesLate     Int?
  notes           String?
  preparedByUserId String?
  preparedByName   String?
  readyByUserId    String?
  readyByName      String?
  servedByUserId   String?
  servedByName     String?
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id])
  unitPrice       Float
  itemName        String
  paymentAllocations PaymentAllocation[]
}

enum RewardStatus {
  PENDING
  REDEEMED
  EXPIRED
}

enum RewardType {
  TEA
  BEVERAGE
}

model Feedback {
  id           String     @id @default(cuid())
  stars        Int
  message      String?
  customerName String?
  tableNumber  Int
  orderId      String?
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model Reward {
  id           String       @id @default(cuid())
  code         String       @unique
  rewardType   RewardType
  rewardLabel  String
  customerName String
  tableNumber  Int
  orderTotal   Float
  validDate    String
  expiresAt    DateTime
  status       RewardStatus @default(PENDING)
  orderId      String?
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  redeemedAt   DateTime?

  @@index([restaurantId, status])
  @@index([validDate])
}

model Alert {
  id           String   @id @default(cuid())
  type         String
  message      String
  orderId      String?
  orderItemId  String?
  tableNumber  Int
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([restaurantId, isRead])
}
