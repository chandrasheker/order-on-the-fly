generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  OWNER
  MANAGER
  COOK
  SERVER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  UNAVAILABLE
}

enum TableSwitchRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum TableKind {
  DINE_IN
  TAKEAWAY
  DELIVERY
  AGGREGATOR
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
  DELIVERY
  SWIGGY
  ZOMATO
  WALK_IN
}

enum AggregatorPlatform {
  SWIGGY
  ZOMATO
}

enum AggregatorConnectionStatus {
  NOT_CONFIGURED
  CREDENTIALS_SAVED
  WEBHOOK_PENDING
  CONNECTED
  ERROR
}

enum ReservationStatus {
  WAITLIST
  CONFIRMED
  NOTIFIED
  SEATED
  CANCELLED
  NO_SHOW
}

enum AuditActionType {
  REJECT_ITEM
  VOID_ORDER
  COMP
  DISCOUNT
  STOCK_ADJUST
}

enum PromotionType {
  PERCENT
  FIXED
  BOGO
  CATEGORY_PERCENT
}

enum GuestServiceType {
  CALL_WAITER
  REQUEST_BILL
  WATER
  REFILL
  OTHER
}

enum GuestServiceStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum PaymentGatewayProvider {
  RAZORPAY
  PHONEPE
  PAYTM
}

enum TenantPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  DEMO
  ACTIVE
  EXPIRED
  PAST_DUE
  CANCELLED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PrintJobStatus {
  PENDING
  SENT
  ACKED
  FAILED
}

enum ReconciliationStatus {
  OPEN
  BALANCED
  VARIANCE
}

enum PlatformEventType {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_PAID
  PAYMENT_RECEIVED
  INVENTORY_CHANGED
  KITCHEN_PAUSED
  GUEST_SERVICE
  MENU_UPDATED
  STAFF_ACTION
}

enum IngredientUnit {
  GRAM
  ML
  PIECE
}

model Restaurant {
  id                    String         @id @default(cuid())
  name                  String
  slug                  String         @unique
  logoUrl               String?
  backgroundImageUrl    String?
  rewardThresholdTea    Float          @default(250)
  rewardThresholdBeverage Float        @default(500)
  rewardTeaLabel        String         @default("Free Masala Chai (next visit)")
  rewardBeverageLabel   String         @default("Free Beverage (next visit)")
  defaultMaxSessions  Int            @default(2)
  ownerSlots            Int            @default(1)
  managerSlots          Int            @default(2)
  cookSlots             Int            @default(3)
  serverSlots           Int            @default(4)
  staffConfigured       Boolean        @default(false)
  paymentQrUrl          String?
  receiptAddress        String?
  receiptPhone          String?
  receiptGstin          String?
  receiptGstEnabled     Boolean        @default(false)
  receiptGstRate        Float          @default(5)
  receiptFooter         String?
  featureFlags          String         @default("{}")
  aggregatorWebhookSecret String?
  kitchenPaused         Boolean        @default(false)
  kitchenPauseMessage   String?
  kitchenAutoPauseOverdueThreshold Int   @default(0)
  paymentGatewayProvider PaymentGatewayProvider?
  paymentGatewayKeyId   String?
  paymentGatewaySecretEnc String?
  paymentWebhookSecret  String?
  pushAlertsEnabled     Boolean        @default(true)
  smsAlertsEnabled      Boolean        @default(true)
  tenantId              String?
  tenant                Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  nameNormalized        String         @default("")
  isEnabled             Boolean        @default(true)
  createdAt             DateTime       @default(now())
  branches              Branch[]
  users                 User[]
  tables                Table[]
  tableSwitchRequests   TableSwitchRequest[]
  categories            MenuCategory[]
  orders                Order[]
  alerts                Alert[]
  feedbacks             Feedback[]
  rewards               Reward[]
  kitchenStations       KitchenStation[]
  payments              Payment[]
  aggregatorConnections AggregatorConnection[]
  reservations          Reservation[]
  shiftClocks           ShiftClock[]
  guestProfiles         GuestProfile[]
  auditLogs             AuditLog[]
  tipPoolPayouts        TipPoolPayout[]
  promotions            Promotion[]
  comboMeals            ComboMeal[]
  modifierGroups        ModifierGroup[]
  guestServiceRequests  GuestServiceRequest[]
  pushSubscriptions     PushSubscription[]
  paymentWebhookEvents  PaymentWebhookEvent[]
  backgroundJobs        BackgroundJob[]
  platformEvents        PlatformEvent[]
  ingredients           Ingredient[]
  apiKeys               ApiKey[]
  demandForecasts       DemandForecast[]
  floors                Floor[]
  printJobs             PrintJob[]
  paymentReconciliations PaymentReconciliation[]
  staffSessions          StaffSession[]
  hostSlugs              HostSlug[]

  @@unique([tenantId, nameNormalized])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role
  slotKey      String?
  plainPassword String?
  restaurantId String
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedTables Table[]    @relation("TableServer")
  shiftClocks    ShiftClock[]
  staffSessions  StaffSession[]
  createdAt      DateTime   @default(now())

  @@unique([restaurantId, slotKey])
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Platform Admin")
  createdAt    DateTime @default(now())
}

model StaffSession {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tenantId     String?
  role         Role
  loginAt      DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  logoutAt     DateTime?
  ipAddress    String?
  userAgent    String?

  @@index([restaurantId, logoutAt, lastSeenAt])
  @@index([tenantId, logoutAt, lastSeenAt])
  @@index([userId, logoutAt])
}

model LoginAuditLog {
  id              String   @id @default(cuid())
  kind            String
  success         Boolean
  email           String
  userId          String?
  platformAdminId String?
  tenantId        String?
  restaurantId    String?
  role            String?
  failureReason   String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([kind, createdAt])
  @@index([email, createdAt])
}

model Table {
  id           String         @id @default(cuid())
  number       Int
  qrToken      String         @unique @default(cuid())
  kind         TableKind      @default(DINE_IN)
  serviceLabel String?
  isActive     Boolean        @default(true)
  orderingEnabled Boolean     @default(false)
  orderingOpenedAt DateTime?
  maxSessions  Int            @default(2)
  positionX    Float?
  positionY    Float?
  width        Float?         @default(96)
  height       Float?         @default(96)
  section      String?
  assignedServerId String?
  assignedServer   User?      @relation("TableServer", fields: [assignedServerId], references: [id], onDelete: SetNull)
  seatedAt     DateTime?
  guestCount   Int?
  currentTabId String?
  tabPaymentRequestedAt DateTime?
  restaurantId String
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  floorId      String?
  floor        Floor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  sessions     TableSession[]
  payments     Payment[]
  sourceSwitchRequests TableSwitchRequest[] @relation("SourceTableSwitchRequests")
  targetSwitchRequests TableSwitchRequest[] @relation("TargetTableSwitchRequests")
  reservations         Reservation[]
  guestServiceRequests GuestServiceRequest[]
  cartDrafts           TableCartDraft[]

  @@unique([restaurantId, number])
}

enum CartDraftSource {
  CUSTOMER
  STAFF
}

model TableCartDraft {
  id         String          @id @default(cuid())
  tableId    String
  table      Table           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  draftKey   String
  source     CartDraftSource
  itemsJson  String          @default("[]")
  updatedAt  DateTime        @updatedAt

  @@unique([tableId, draftKey, source])
  @@index([tableId, updatedAt])
}

model TableSession {
  id         String   @id @default(cuid())
  sessionKey String
  tableId    String
  table      Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([tableId, sessionKey])
  @@index([tableId, lastSeenAt])
}

model TableSwitchRequest {
  id                String                   @id @default(cuid())
  status            TableSwitchRequestStatus @default(PENDING)
  customerName      String?
  sessionKey        String
  note              String?
  sourceTableNumber Int
  targetTableNumber Int
  sourceTableId     String
  sourceTable       Table                    @relation("SourceTableSwitchRequests", fields: [sourceTableId], references: [id], onDelete: Cascade)
  targetTableId     String
  targetTable       Table                    @relation("TargetTableSwitchRequests", fields: [targetTableId], references: [id], onDelete: Cascade)
  restaurantId      String
  restaurant        Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  approvedByUserId  String?
  approvedByName    String?
  requestedAt       DateTime                 @default(now())
  respondedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([restaurantId, status])
  @@index([sourceTableId, status])
  @@index([targetTableId])
}

model MenuCategory {
  id           String     @id @default(cuid())
  name         String
  slug         String
  icon         String?
  isEnabled    Boolean    @default(true)
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@unique([restaurantId, slug])
}

model MenuItem {
  id              String       @id @default(cuid())
  name            String
  description     String?
  price           Float
  prepTimeMinutes Int          @default(10)
  imageUrl        String?
  isAvailable     Boolean      @default(true)
  isVeg           Boolean      @default(true)
  isSpicy         Boolean      @default(false)
  sortOrder       Int          @default(0)
  swiggyItemId    String?
  zomatoItemId    String?
  trackInventory  Boolean      @default(false)
  stockQuantity   Int?
  lowStockThreshold Int        @default(5)
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  modifierGroups  MenuItemModifierGroup[]
  comboMealItems  ComboMealItem[]
  recipeLines     RecipeLine[]
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    Int
  customerName   String?
  customerPhone  String?
  orderChannel   OrderChannel @default(DINE_IN)
  externalOrderId String?
  orderNotes     String?
  aggregatorReadyPushedAt DateTime?
  aggregatorPickedUpPushedAt DateTime?
  status         OrderStatus @default(PENDING)
  tableId        String
  table          Table       @relation(fields: [tableId], references: [id])
  restaurantId   String
  tenantId       String?
  tenant         Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  floorId        String?
  floor          Floor?      @relation(fields: [floorId], references: [id], onDelete: SetNull)
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  printJobs      PrintJob[]
  alarmTriggered Boolean     @default(false)
  rewardSpun     Boolean     @default(false)
  tabId          String?
  paidAt         DateTime?
  paymentRequestedAt DateTime?
  oosNoticeDismissedAt DateTime?
  placedByUserId     String?
  placedByName       String?
  paidByUserId       String?
  paidByName         String?
  tipAmount          Float       @default(0)
  discountAmount     Float       @default(0)
  promoCode          String?
  promoDiscount      Float       @default(0)
  compReason         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  date           String
  payments       Payment[]

  @@index([restaurantId, date])
  @@index([tableId])
  @@index([restaurantId, orderChannel, externalOrderId])
}

model AggregatorConnection {
  id              String                     @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  platform        AggregatorPlatform
  outletId        String?
  apiKeyEnc       String?
  apiSecretEnc    String?
  webhookSecret   String?
  autoConfirm     Boolean                    @default(true)
  autoMenuSync    Boolean                    @default(true)
  pushStatusUpdates Boolean                  @default(true)
  status          AggregatorConnectionStatus @default(NOT_CONFIGURED)
  lastOrderAt     DateTime?
  lastMenuSyncAt  DateTime?
  lastError       String?
  configuredAt    DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([restaurantId, platform])
}

model KitchenStation {
  id            String     @id @default(cuid())
  name          String
  slug          String
  color         String     @default("#3b82f6")
  categorySlugs String
  sortOrder     Int        @default(0)
  restaurantId  String
  branchId      String?
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, slug])
}

model Payment {
  id                String              @id @default(cuid())
  restaurantId      String
  tenantId          String?
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branchId          String?
  branch            Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurant        Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId           String
  table             Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Float
  method            PaymentMethod       @default(UPI)
  note              String?
  collectedByUserId String?
  collectedByName   String?
  createdAt         DateTime            @default(now())
  allocations       PaymentAllocation[]

  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@index([tableId])
}

model PaymentAllocation {
  id          String    @id @default(cuid())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  amount      Float

  @@index([orderItemId])
}

model OrderItem {
  id              String          @id @default(cuid())
  quantity        Int             @default(1)
  status          OrderItemStatus @default(PENDING)
  prepTimeMinutes Int
  expectedReadyAt DateTime
  servedAt        DateTime?
  isOverdue       Boolean         @default(false)
  missedTimeline  Boolean         @default(false)
  minutesLate     Int?
  notes           String?
  preparedByUserId String?
  preparedByName   String?
  readyByUserId    String?
  readyByName      String?
  servedByUserId   String?
  servedByName     String?
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id])
  unitPrice       Float
  itemName        String
  modifiersJson   String?
  paymentAllocations PaymentAllocation[]
}

enum RewardStatus {
  PENDING
  REDEEMED
  EXPIRED
}

enum RewardType {
  TEA
  BEVERAGE
}

model Feedback {
  id           String     @id @default(cuid())
  stars        Int
  message      String?
  customerName String?
  tableNumber  Int
  orderId      String?
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model Reward {
  id           String       @id @default(cuid())
  code         String       @unique
  rewardType   RewardType
  rewardLabel  String
  customerName String
  tableNumber  Int
  orderTotal   Float
  validDate    String
  expiresAt    DateTime
  status       RewardStatus @default(PENDING)
  orderId      String?
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  redeemedAt   DateTime?

  @@index([restaurantId, status])
  @@index([validDate])
}

model Alert {
  id           String   @id @default(cuid())
  type         String
  message      String
  orderId      String?
  orderItemId  String?
  tableNumber  Int
  restaurantId String
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  targetUserId   String?
  categorySlug   String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([restaurantId, isRead])
  @@index([targetUserId])
}

model Reservation {
  id           String            @id @default(cuid())
  restaurantId String
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  guestName    String
  guestPhone   String
  partySize    Int               @default(2)
  scheduledAt  DateTime?
  status       ReservationStatus @default(WAITLIST)
  tableId      String?
  table        Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  notes        String?
  notifiedAt   DateTime?
  seatedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([restaurantId, status])
  @@index([restaurantId, scheduledAt])
}

model ShiftClock {
  id           String     @id @default(cuid())
  restaurantId String
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockInAt    DateTime   @default(now())
  clockOutAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, clockInAt])
  @@index([userId, clockOutAt])
}

model GuestProfile {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  phone        String
  name         String?
  visitCount   Int        @default(0)
  totalSpend   Float      @default(0)
  lastVisitAt  DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, phone])
  @@index([restaurantId, lastVisitAt])
}

model AuditLog {
  id               String          @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actionType       AuditActionType
  entityId         String?
  reason           String?
  payload          String?
  oldValue         String?
  newValue         String?
  branchId         String?
  actorUserId      String?
  actorName        String?
  approvedByUserId String?
  approvedByName   String?
  requiresApproval Boolean         @default(false)
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, actionType])
}

model TipPoolPayout {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  periodStart   String
  periodEnd     String
  totalTips     Float
  exportData    String
  createdByName String?
  createdAt     DateTime   @default(now())

  @@index([restaurantId, periodStart])
}

model Promotion {
  id             String         @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  type           PromotionType
  value          Float          @default(0)
  code           String?
  categorySlug   String?
  menuItemId     String?
  comboMealId    String?
  minOrderAmount Float          @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  daysOfWeek     String?
  startHour      Int?
  endHour        Int?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([restaurantId, isActive])
  @@index([restaurantId, code])
}

model ComboMeal {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  comboPrice   Float
  imageUrl     String?
  isAvailable  Boolean         @default(true)
  sortOrder    Int             @default(0)
  items        ComboMealItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([restaurantId])
}

model ComboMealItem {
  id         String   @id @default(cuid())
  comboMealId String
  comboMeal  ComboMeal @relation(fields: [comboMealId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)

  @@index([comboMealId])
}

model ModifierGroup {
  id           String                  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  required     Boolean                 @default(false)
  minSelect    Int                     @default(0)
  maxSelect    Int                     @default(1)
  sortOrder    Int                     @default(0)
  options      ModifierOption[]
  menuItems    MenuItemModifierGroup[]
  createdAt    DateTime                @default(now())

  @@index([restaurantId])
}

model ModifierOption {
  id         String        @id @default(cuid())
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Float         @default(0)
  isDefault  Boolean       @default(false)
  sortOrder  Int           @default(0)

  @@index([groupId])
}

model MenuItemModifierGroup {
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
}

model GuestServiceRequest {
  id                   String             @id @default(cuid())
  restaurantId         String
  restaurant           Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId              String
  table                Table              @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionKey           String?
  type                 GuestServiceType
  message              String?
  status               GuestServiceStatus @default(PENDING)
  acknowledgedByUserId String?
  acknowledgedByName   String?
  createdAt            DateTime           @default(now())
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?

  @@index([restaurantId, status])
}

model PushSubscription {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  endpoint     String     @unique
  p256dh       String
  auth         String
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

model PaymentWebhookEvent {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider     String
  externalId   String
  amount       Float
  tableId      String?
  orderId      String?
  status       String     @default("RECEIVED")
  payload      String?
  processedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@unique([provider, externalId])
  @@index([restaurantId, createdAt])
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  nameNormalized     String             @unique @default("")
  slug               String             @unique
  plan               TenantPlan         @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  billingEmail       String?
  externalBillingId  String?
  demoPackUsedAt     DateTime?
  demoExpiresAt      DateTime?
  isEnabled          Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  restaurants        Restaurant[]
  subscriptions      TenantSubscription[]
  branches           Branch[]
  floors             Floor[]
  users              User[]
  tables             Table[]
  orders             Order[]
  payments           Payment[]
  alerts             Alert[]
  platformEvents     PlatformEvent[]
  printJobs          PrintJob[]
  paymentReconciliations PaymentReconciliation[]
  admins             TenantAdmin[]
  hostSlugs          HostSlug[]
}

/** Global DNS-label lease for tenant hubs and restaurants. */
model HostSlug {
  slug         String     @id
  kind         String
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tenantId, kind])
  @@index([restaurantId])
}

/** Tenant-host admin. Separate from restaurant OWNER and platform admin. */
model TenantAdmin {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@index([email])
}

model TenantSubscription {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan             TenantPlan
  status           SubscriptionStatus @default(TRIAL)
  currentPeriodEnd DateTime?
  metadata         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId, status])
}

model Branch {
  id              String           @id @default(cuid())
  restaurantId    String
  tenantId        String?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  isDefault       Boolean          @default(false)
  address         String?
  timezone        String           @default("Asia/Kolkata")
  createdAt       DateTime         @default(now())
  floors          Floor[]
  tables          Table[]
  orders          Order[]
  kitchenStations KitchenStation[]
  reservations    Reservation[]
  shiftClocks     ShiftClock[]
  users           User[]
  payments        Payment[]
  alerts          Alert[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, isDefault])
}

model Floor {
  id           String     @id @default(cuid())
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  restaurantId String
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  sortOrder    Int        @default(0)
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  tables       Table[]
  orders       Order[]

  @@unique([branchId, slug])
  @@index([restaurantId, branchId])
}

model BackgroundJob {
  id           String    @id @default(cuid())
  type         String
  payload      String
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  scheduledAt  DateTime  @default(now())
  processedAt  DateTime?
  error        String?
  restaurantId String?
  tenantId     String?
  branchId     String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([restaurantId, createdAt])
  @@index([tenantId, createdAt])
}

model PlatformEvent {
  id           String            @id @default(cuid())
  restaurantId String
  tenantId     String?
  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  floorId      String?
  type         PlatformEventType
  entityId     String?
  payload      String?
  createdAt    DateTime          @default(now())

  @@index([restaurantId, type, createdAt])
  @@index([restaurantId, createdAt])
  @@index([tenantId, createdAt])
}

model PrintJob {
  id           String         @id @default(cuid())
  restaurantId String
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branchId     String?
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kind         String         @default("kitchen_chit")
  payload      String
  status       PrintJobStatus @default(PENDING)
  ackToken     String         @unique @default(cuid())
  attempts     Int            @default(0)
  maxAttempts  Int            @default(5)
  lastError    String?
  sentAt       DateTime?
  ackedAt      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([restaurantId, status])
  @@index([status, createdAt])
}

model PaymentReconciliation {
  id             String               @id @default(cuid())
  restaurantId   String
  tenantId       String?
  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  periodDate     String
  expectedTotal  Float                @default(0)
  receivedTotal  Float                @default(0)
  variance       Float                @default(0)
  status         ReconciliationStatus @default(OPEN)
  details        String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([restaurantId, periodDate])
  @@index([tenantId, periodDate])
}

model Ingredient {
  id                String         @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name              String
  unit              IngredientUnit @default(GRAM)
  stockQuantity     Float          @default(0)
  lowStockThreshold Float          @default(0)
  recipeLines       RecipeLine[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([restaurantId, name])
}

model RecipeLine {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float

  @@unique([menuItemId, ingredientId])
}

model ApiKey {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String     @unique
  keyPrefix    String
  scopes       String     @default("[\"orders:read\"]")
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, revokedAt])
}

model DemandForecast {
  id                String     @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId        String
  menuItemName      String
  date              String
  predictedQuantity Float
  confidence        Float      @default(0.5)
  modelVersion      String     @default("v1-sma")
  createdAt         DateTime   @default(now())

  @@unique([restaurantId, menuItemId, date])
  @@index([restaurantId, date])
}
