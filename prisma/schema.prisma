generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  OWNER
  MANAGER
  COOK
  SERVER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  UNAVAILABLE
}

model Restaurant {
  id                    String         @id @default(cuid())
  name                  String
  slug                  String         @unique
  logoUrl               String?
  backgroundImageUrl    String?
  rewardThresholdTea    Float          @default(250)
  rewardThresholdBeverage Float        @default(500)
  rewardTeaLabel        String         @default("Free Masala Chai (next visit)")
  rewardBeverageLabel   String         @default("Free Beverage (next visit)")
  defaultMaxSessions  Int            @default(2)
  ownerSlots            Int            @default(1)
  managerSlots          Int            @default(2)
  cookSlots             Int            @default(3)
  serverSlots           Int            @default(4)
  staffConfigured       Boolean        @default(false)
  createdAt             DateTime       @default(now())
  users                 User[]
  tables                Table[]
  categories            MenuCategory[]
  orders                Order[]
  alerts                Alert[]
  feedbacks             Feedback[]
  rewards               Reward[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role
  slotKey      String?
  plainPassword String?
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, slotKey])
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Platform Admin")
  createdAt    DateTime @default(now())
}

model Table {
  id           String         @id @default(cuid())
  number       Int
  qrToken      String         @unique @default(cuid())
  isActive     Boolean        @default(true)
  maxSessions  Int            @default(2)
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  sessions     TableSession[]

  @@unique([restaurantId, number])
}

model TableSession {
  id         String   @id @default(cuid())
  sessionKey String
  tableId    String
  table      Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([tableId, sessionKey])
  @@index([tableId, lastSeenAt])
}

model MenuCategory {
  id           String     @id @default(cuid())
  name         String
  slug         String
  icon         String?
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@unique([restaurantId, slug])
}

model MenuItem {
  id              String       @id @default(cuid())
  name            String
  description     String?
  price           Float
  prepTimeMinutes Int          @default(10)
  imageUrl        String?
  isAvailable     Boolean      @default(true)
  isVeg           Boolean      @default(true)
  isSpicy         Boolean      @default(false)
  sortOrder       Int          @default(0)
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    Int
  customerName   String?
  status         OrderStatus @default(PENDING)
  tableId        String
  table          Table       @relation(fields: [tableId], references: [id])
  restaurantId   String
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  alarmTriggered Boolean     @default(false)
  rewardSpun     Boolean     @default(false)
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  date           String

  @@index([restaurantId, date])
  @@index([tableId])
}

model OrderItem {
  id              String          @id @default(cuid())
  quantity        Int             @default(1)
  status          OrderItemStatus @default(PENDING)
  prepTimeMinutes Int
  expectedReadyAt DateTime
  servedAt        DateTime?
  isOverdue       Boolean         @default(false)
  missedTimeline  Boolean         @default(false)
  minutesLate     Int?
  notes           String?
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id])
  unitPrice       Float
  itemName        String
}

enum RewardStatus {
  PENDING
  REDEEMED
  EXPIRED
}

enum RewardType {
  TEA
  BEVERAGE
}

model Feedback {
  id           String     @id @default(cuid())
  stars        Int
  message      String?
  customerName String?
  tableNumber  Int
  orderId      String?
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model Reward {
  id           String       @id @default(cuid())
  code         String       @unique
  rewardType   RewardType
  rewardLabel  String
  customerName String
  tableNumber  Int
  orderTotal   Float
  validDate    String
  expiresAt    DateTime
  status       RewardStatus @default(PENDING)
  orderId      String?
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  redeemedAt   DateTime?

  @@index([restaurantId, status])
  @@index([validDate])
}

model Alert {
  id           String   @id @default(cuid())
  type         String
  message      String
  orderId      String?
  orderItemId  String?
  tableNumber  Int
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([restaurantId, isRead])
}
